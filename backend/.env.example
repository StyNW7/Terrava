# =============================================================================
# Terrava backend configuration
# Copy to .env and adjust. Every variable is validated at boot (src/config).
# =============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Comma-separated origins allowed to call the API (the Vite dev server and preview).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Public URL of the web app, used in email links (reset password, invitations).
APP_URL=http://localhost:5173

# --- Database ------------------------------------------------------------------
# Local (npm run db:local):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/terrava"
#
# Neon: use the *pooled* string for DATABASE_URL and the direct one for DIRECT_URL
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/terrava?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/terrava?sslmode=require"
#
# Supabase: Project Settings -> Database -> Connection string
# DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Auth ------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_TTL_REMEMBER_DAYS=30

# --- Rate limiting -----------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# --- Email (optional; without SMTP_HOST messages are printed to the console) -------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Terrava <no-reply@terrava.id>"
CONTACT_INBOX=hello@terrava.id

# --- WhatsApp (optional; Fonnte / Wablas style HTTP gateway) -----------------------
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Weather (Open-Meteo, free, no key) ---------------------------------------------
WEATHER_ENABLED=true
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# --- Background jobs -----------------------------------------------------------------
# Offline detection, uptime, insights, scheduled reports, heat-wave forecast, retention.
JOBS_ENABLED=true
DEVICE_OFFLINE_MINUTES=120
TELEMETRY_RETENTION_DAYS=365

# OpenAPI UI at /docs
SWAGGER_ENABLED=true
