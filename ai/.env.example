# Terrava AI service configuration (all optional).

TERRAVA_AI_HOST=0.0.0.0
TERRAVA_AI_PORT=8000
TERRAVA_AI_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:4000

# Require this key in the `x-api-key` header for every /v1 request (recommended in production).
TERRAVA_AI_API_KEY=

# Models are trained on first start when missing (about 30 s).
TERRAVA_AI_AUTO_TRAIN=true
TERRAVA_AI_TRAINING_SAMPLES=14000

# Claude powers the Terra assistant. Leave empty for offline mode
# (answers from the knowledge base and the local models).
ANTHROPIC_API_KEY=
TERRAVA_AI_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (low suits a chat assistant)
TERRAVA_AI_LLM_EFFORT=low
