# Copy this file to .env.local (git-ignored) and fill in your own keys.
# Restrict every key to your domains in the provider dashboard: map keys are
# visible in browser requests, so the domain lock is what protects them.

# CARTO basemaps (light + dark map). Get one at https://carto.com/basemaps/apikey
# Without it the map falls back to OpenStreetMap tiles.
VITE_CARTO_API_KEY=

# Optional: ArcGIS Location Platform key for the satellite layer.
VITE_ARCGIS_API_KEY=
